{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Deploys always name an environment: `--env staging` (every push to main) or
  // `--env production` (published releases), see .github/workflows/deploy_cloudflare.yaml.
  // The top level holds what both share; its bindings are only used by local
  // previews (`npm run cf:preview`). Bindings, routes and secrets aren't inherited,
  // so each environment lists its own. Resource names are the source of truth:
  // the deploy workflow creates missing buckets and databases by these names.
  "name": "hackdex-website",
  // OpenNext's worker plus the daily catalog reconcile (see worker.ts).
  "main": "worker.ts",
  "compatibility_date": "2026-11-04",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "hackdex-website" }],
  "r2_buckets": [
    { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "hackdex-local-next-cache" },
    { "binding": "CATALOG_BUCKET", "bucket_name": "hackdex-local-catalog" }
  ],
  "d1_databases": [{ "binding": "NEXT_TAG_CACHE_D1", "database_name": "hackdex-local-next-tag-cache" }],
  "durable_objects": {
    "bindings": [{ "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DOQueueHandler"] }],
  // Daily catalog reconcile at 03:17 UTC (worker.ts). Inherited by both environments.
  "triggers": {
    "crons": ["17 3 * * *"]
  },
  "images": {
    "binding": "IMAGES"
  },
  // Smart Placement moves rendering next to Supabase once there's enough
  // traffic. If the Supabase region is known, a fixed hint is more predictable:
  // "placement": { "region": "aws:<supabase-region>" }
  "placement": {
    "mode": "smart"
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "env": {
    "staging": {
      // Worker name: hackdex-website-staging.
      "routes": [{ "pattern": "staging.hackdex.app", "custom_domain": true }],
      "workers_dev": false,
      "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "hackdex-website-staging" }],
      "r2_buckets": [
        { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "hackdex-staging-next-cache" },
        // Public catalog (catalog/v1/), served from its own custom domain.
        { "binding": "CATALOG_BUCKET", "bucket_name": "hackdex-staging-catalog" }
      ],
      "d1_databases": [{ "binding": "NEXT_TAG_CACHE_D1", "database_name": "hackdex-staging-next-tag-cache" }],
      "durable_objects": {
        "bindings": [{ "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" }]
      },
      "images": { "binding": "IMAGES" },
      // Deploys fail if one of these isn't set. The values come from the GitHub
      // Environment "staging" (see docs/cloudflare.md).
      "secrets": {
        "required": [
          "SUPABASE_SECRET_KEY", "TURNSTILE_SECRET_KEY",
          "S3_ENDPOINT", "S3_USE_SSL", "S3_ACCESS_KEY_ID", "S3_SECRET_ACCESS_KEY", "PATCHES_BUCKET", "COVERS_BUCKET"
        ]
      }
    },
    "production": {
      // Worker name: hackdex-website-production. Until the move from Vercel it only
      // answers on workers.dev, for comparison. At the switch, remove hackdex.app's
      // DNS records that point to Vercel (a custom domain can't take over a hostname
      // with an existing CNAME), then add:
      // "routes": [{ "pattern": "hackdex.app", "custom_domain": true }, { "pattern": "www.hackdex.app", "custom_domain": true }],
      "workers_dev": true,
      "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "hackdex-website-production" }],
      "r2_buckets": [
        { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "hackdex-next-cache" },
        { "binding": "CATALOG_BUCKET", "bucket_name": "hackdex-catalog" }
      ],
      "d1_databases": [{ "binding": "NEXT_TAG_CACHE_D1", "database_name": "hackdex-next-tag-cache" }],
      "durable_objects": {
        "bindings": [{ "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" }]
      },
      "images": { "binding": "IMAGES" },
      "secrets": {
        "required": [
          "SUPABASE_SECRET_KEY", "TURNSTILE_SECRET_KEY",
          "S3_ENDPOINT", "S3_USE_SSL", "S3_ACCESS_KEY_ID", "S3_SECRET_ACCESS_KEY", "PATCHES_BUCKET", "COVERS_BUCKET"
        ]
      }
    }
  }
}
