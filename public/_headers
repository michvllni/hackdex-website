# Cloudflare static asset headers. Assets are served without running the
# Worker, so next.config.ts headers() doesn't reach them; keep these in sync.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/logo.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/favicon.ico
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
